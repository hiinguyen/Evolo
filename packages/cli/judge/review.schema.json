{
  "$comment": "Shape of the xp-review answer. review.mjs validates it again and checks every finding's location against the repository.",
  "type": "object",
  "additionalProperties": false,
  "required": ["overview", "strengths", "improvements", "findings", "flags", "notes"],
  "properties": {
    "overview": { "type": "string" },
    "strengths": { "type": "array", "items": { "type": "string" } },
    "improvements": { "type": "array", "items": { "type": "string" } },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "category", "location", "title", "detail", "suggestion"],
        "properties": {
          "severity": { "enum": ["high", "medium", "low"] },
          "category": { "enum": ["bug", "security", "performance", "test", "design", "readability", "other"] },
          "location": { "type": "string" },
          "title": { "type": "string" },
          "detail": { "type": "string" },
          "suggestion": { "type": "string" }
        }
      }
    },
    "flags": {
      "type": "array",
      "items": { "enum": ["suspected_injection", "incomplete_investigation"] }
    },
    "notes": { "type": "string" }
  }
}
